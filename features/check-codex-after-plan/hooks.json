{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "(tool == 'Write' || tool == 'Edit') && tool_input.file_path != null && tool_input.file_path matches '(^|/)(plan\\.md|PLAN\\.md|design\\.md|DESIGN\\.md|.*-plan\\.md|.*-design\\.md)$'",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/hooks/check-codex-after-plan/check-codex-after-plan.sh",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
